PORT=5050
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com,http://localhost:3000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/addymize?retryWrites=true&w=majority

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=demo-addymize
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_secret

# Email Notifications (Gmail or Custom Domain SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_TO=admin@yourdomain.com

# Optional Custom SMTP (Hostinger, cPanel, Zoho)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=465
# SMTP_SECURE=true
